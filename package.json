{
  "name": "framebassman-elasticsearch-transport",
  "version": "7.10.0",
  "description": "Winston transport to save logs in elasticsearch",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "linter": "eslint .",
    "linter:fix": "eslint . --fix",
    "test": "ava"
  },
  "ava": {
    "typescript": {
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": "tsc"
    }
  },
  "files": [
    "dist"
  ],
  "types": "dist/types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framebassman/winston-elastic.git"
  },
  "bugs": {
    "url": "https://github.com/framebassman/winston-elastic/issue"
  },
  "author": "Dmitry Romashov",
  "license": "MIT",
  "private": false,
  "keywords": [
    "transport-winston",
    "winston",
    "elasticsearch",
    "elastic",
    "types",
    "typescript",
    "log",
    "logging",
    "logger",
    "analyze",
    "tools"
  ],
  "dependencies": {
    "@elastic/elasticsearch": "7.10",
    "ava": "~5.3.1",
    "winston": "~3.10.0",
    "winston-transport": "~4.5.0"
  },
  "devDependencies": {
    "@ava/typescript": "~4.1.0",
    "@types/elasticsearch": "~5.0.40",
    "@types/sinon": "^10.0.16",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "eslint": "^8.48.0",
    "eslint-config-standard-with-typescript": "^39.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.0.2",
    "eslint-plugin-promise": "^6.1.1",
    "sinon": "^15.2.0",
    "typescript": "^5.2.2"
  },
  "homepage": "https://github.com/framebassman/winston-elastic#readme"
}
